<div class="bg-body-tertiary border-start border-4 border-primary p-3">
    <div><strong>@Name GUID:</strong> <code>@_value</code></div>
    <div><strong>Child initialized:</strong> @_initializedAt.ToString("yyyy-MM-dd HH:mm:ss.fff zzz")</div>
</div>

@code {
    [Parameter, EditorRequired]
    public required string Name { get; set; }

    private Guid _value;
    private DateTimeOffset _initializedAt;

    protected override void OnInitialized()
    {
        _value = Guid.NewGuid();
        _initializedAt = DateTimeOffset.Now;
    }
}